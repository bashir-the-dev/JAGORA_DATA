# ============================================================================
# Al'amin Jagora Data - Apache .htaccess for cPanel (public_html)
# ============================================================================

Options -Indexes
Options +FollowSymLinks

# CRITICAL: Always serve index.html (React SPA) as default index before index.php
DirectoryIndex index.html index.php

# Prevent aggressive browser caching of index.html so code updates reflect instantly
<Files "index.html">
  FileETag None
  <IfModule mod_headers.c>
    Header unset ETag
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </IfModule>
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization and custom token headers through to PHP under FastCGI / LiteSpeed / PHP-FPM
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
  RewriteCond %{HTTP:X-Auth-Token} ^(.*)
  RewriteRule .* - [e=HTTP_X_AUTH_TOKEN:%1]
  RewriteCond %{HTTP:X-Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_X_AUTHORIZATION:%1]
  RewriteCond %{HTTP:xixapay} ^(.*)
  RewriteRule .* - [e=HTTP_XIXAPAY:%1]
  RewriteCond %{HTTP:Xixapay} ^(.*)
  RewriteRule .* - [e=HTTP_XIXAPAY:%1]
  RewriteCond %{HTTP:Payvessel-Http-Signature} ^(.*)
  RewriteRule .* - [e=HTTP_PAYVESSEL_HTTP_SIGNATURE:%1]

  # 1. Block access to sensitive database and configuration files
  <FilesMatch "\.(sql|env|ini|log|sh)$">
    Order allow,deny
    Deny from all
  </FilesMatch>

  <Files "config.php">
    Order allow,deny
    Deny from all
  </Files>

  # 2. Subdomain Route Isolation:
  # If customer screens (/home, /login, /bills, /wallet, etc.) are accessed on the staff subdomain,
  # 301 redirect them to the primary customer domain so the staff subdomain remains strictly for staff.
  RewriteCond %{HTTP_HOST} ^(staff|admin)\.(.+)$ [NC]
  RewriteCond %{REQUEST_URI} ^/(home|login|register|dashboard|wallet|bills|history|profile|support|terms|privacy|buy-data|buy-airtime|data-card|recharge-pin|more-services) [NC]
  RewriteRule ^(.*)$ https://%2/$1 [R=301,L]

  # 3. Route all /api/* calls to the PHP API router
  RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

  # 4. Route existing static files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. React Single Page Application (SPA) Fallback
  # Directs all page refreshes to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Gzip Compression for Fast Loading on Mobile Networks
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, Idempotency-Key"
</IfModule>
